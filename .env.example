# TradingAgents v0.3.0 — crypto-only environment variables
# Copy to .env and fill in values. Placeholders only — never commit real secrets.
#
# TRADINGAGENTS_* runtime keys override matching entries in
# tradingagents/default_config.py (types coerced automatically: true/1/yes → bool).
# In the CLI, setting provider / models / backend URL / language skips those prompts.


# -----------------------------------------------------------------------------
# 1. LLM Providers
# -----------------------------------------------------------------------------

# --- API keys (required for the provider you use; leave others unset) ---

# OpenAI — default provider (gpt-5.5 / gpt-5.4-mini)
OPENAI_API_KEY=your_key_here

# Anthropic — Claude models
ANTHROPIC_API_KEY=your_key_here

# Google — Gemini models
GOOGLE_API_KEY=your_key_here

# AtlasCloud — OpenAI-compatible hosted models (https://api.atlascloud.ai/v1)
ATLASCLOUD_API_KEY=your_key_here

# xAI — Grok models
XAI_API_KEY=your_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_key_here

# Qwen (DashScope) — international and China endpoints use separate accounts
DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_CN_API_KEY=your_key_here

# GLM (Zhipu) — international and China endpoints use separate accounts
ZHIPU_API_KEY=your_key_here
ZHIPU_CN_API_KEY=your_key_here

# MiniMax — international and China endpoints use separate accounts
MINIMAX_API_KEY=your_key_here
MINIMAX_CN_API_KEY=your_key_here

# OpenRouter — multi-model gateway
OPENROUTER_API_KEY=your_key_here

# Azure OpenAI — see .env.enterprise.example for AZURE_OPENAI_ENDPOINT,
# AZURE_OPENAI_DEPLOYMENT_NAME, and OPENAI_API_VERSION
AZURE_OPENAI_API_KEY=your_key_here

# --- Local / custom OpenAI-compatible runtimes (Ollama, LM Studio, vLLM) ---

# Base URL for the `local` provider (default: http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# API key sent to the local endpoint (default: local — many servers ignore it)
LOCAL_LLM_API_KEY=local

# Model id on the local server; when set, CLI uses it for both quick and deep agents
LOCAL_LLM_MODEL_NAME=qwen3:latest

# Remote Ollama for the `ollama` provider (default: http://localhost:11434/v1)
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# --- Provider & model selection (optional; skips matching CLI prompts) ---

# LLM backend: openai | anthropic | google | atlascloud | local | ollama | xai | ...
#TRADINGAGENTS_LLM_PROVIDER=openai

# Deep-thinking agent model (research manager, portfolio manager, …)
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5

# Quick-thinking agent model (analysts, debators, trader, …)
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini

# Override provider default API base URL (corporate proxy, OpenCode, LM Studio, …)
#TRADINGAGENTS_LLM_BACKEND_URL=

# Sampling temperature — lower reduces run-to-run variation where the model honors it.
# Unset leaves each provider at its default. Does not make output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0

# Provider-specific reasoning / thinking (no TRADINGAGENTS_* env override yet).
# Set via interactive CLI (Step 8) or programmatically in DEFAULT_CONFIG:
#   google_thinking_level      — Gemini: high, minimal, …
#   openai_reasoning_effort    — OpenAI reasoning models: low, medium, high
#   anthropic_effort           — Claude Opus/Sonnet 4.5+: low, medium, high


# -----------------------------------------------------------------------------
# 2. TradingAgents runtime
# -----------------------------------------------------------------------------

# Report language for analyst output and final decision (debate stays English)
#TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Bull/bear researcher debate rounds (integer)
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1

# Risk analyst discussion rounds (integer)
#TRADINGAGENTS_MAX_RISK_ROUNDS=1

# LangGraph checkpoint/resume after each node (also: --checkpoint flag)
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Benchmark pair for alpha in the reflection layer (overrides auto-detection)
#TRADINGAGENTS_BENCHMARK_TICKER=ETH/USDT

# Live price feed for backtest deploy bridge (see also LIVE_MODE in section 4)
#TRADINGAGENTS_LIVE_MODE=false


# -----------------------------------------------------------------------------
# 3. Crypto data vendors
# -----------------------------------------------------------------------------

# CoinGecko — Demo keys use api.coingecko.com; Pro keys use pro-api.coingecko.com
# Leave unset for anonymous access (strict rate limits). Tier: demo | pro | auto (default)
COINGECKO_API_KEY=your_key_here
#COINGECKO_API_TIER=auto
#TRADINGAGENTS_COINGECKO_API_KEY=your_key_here

# LunarCrush — galaxy score, social volume (required for LunarCrush sentiment tools)
LUNARCRUSH_API_KEY=your_key_here
#TRADINGAGENTS_LUNARCRUSH_API_KEY=your_key_here

# CryptoCompare — OHLCV fallback and crypto news (optional; public limits without key)
CRYPTOCOMPARE_API_KEY=your_key_here
#TRADINGAGENTS_CRYPTOCOMPARE_API_KEY=your_key_here

# Glassnode — on-chain metrics stub (optional; extend onchain_metrics.py for live use)
#GLASSNODE_API_KEY=your_key_here
#TRADINGAGENTS_GLASSNODE_API_KEY=your_key_here

# Binance USD-M perps (funding, open interest) and primary OHLCV — public REST, no key.


# -----------------------------------------------------------------------------
# 4. Backtest / live paper trading
# -----------------------------------------------------------------------------

# Enable ccxt Binance live ticker when CryptoCompare/CoinGecko are unavailable (1|true|yes|on)
#LIVE_MODE=1

# Same as LIVE_MODE but via DEFAULT_CONFIG override (true|false)
#TRADINGAGENTS_LIVE_MODE=false

# Paper trading simulation (no real orders) — CLI: tradingagents paper --ticker BTC/USDT
#TRADINGAGENTS_PAPER_TRADE_ENABLED=false
#TRADINGAGENTS_PAPER_INITIAL_EQUITY=100000
#TRADINGAGENTS_PAPER_TICK_INTERVAL_SECONDS=10
#TRADINGAGENTS_PAPER_ADAPTIVE_ENABLED=true
#TRADINGAGENTS_PAPER_STATE_ENABLED=true

# Adaptive re-backtest / autonomous rotation (aliases below)
#TRADINGAGENTS_PAPER_LOSS_REVIEW_MINUTES=60
#TRADINGAGENTS_PAPER_LOSS_THRESHOLD_PCT=5.0
#TRADINGAGENTS_DRAWDOWN_TIME_WINDOW=60
#TRADINGAGENTS_MAX_ALLOWED_DRAWDOWN_PCT=5.0

# Slippage is not env-configurable — SimulatedMatcher defaults to 5 bps; the
# optimization engine derives slippage from transaction_cost_pct in code.


# -----------------------------------------------------------------------------
# 5. Paths
# -----------------------------------------------------------------------------

# Analysis run logs and reports (default: ~/.tradingagents/logs)
#TRADINGAGENTS_RESULTS_DIR=~/.tradingagents/logs

# Data cache and LangGraph SQLite checkpoints (default: ~/.tradingagents/cache)
#TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache

# Decision memory log for cross-run reflection (default: ~/.tradingagents/memory/trading_memory.md)
#TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md
