# =============================================================================
# QUICK START (copy to .env file and fill in)
# =============================================================================
#
# Local LLM settings below are active by default and override cloud provider
# options later in this file. Leave this block enabled to run against a local
# OpenAI-compatible server (Ollama, LM Studio, vLLM). To use OpenAI, Anthropic,
# AtlasCloud, etc., comment out this entire block and enable the matching vars
# in "LLM Provider API Keys" and "TradingAgents Runtime" below.

#### FILL IN THESE FOR LOCAL LLM ####
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=usually_none
LOCAL_LLM_MODEL_NAME=qwen3:latest

#Comment out above and uncomment below if using Ollama.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1
#LOCAL_LLM_MODEL_NAME=qwen3:latest

### Defaults to LOCAL_LLM_MODEL_NAME if not set.
TRADINGAGENTS_LLM_PROVIDER=local
#TRADINGAGENTS_DEEP_THINK_LLM=qwen3.6:latest
#TRADINGAGENTS_QUICK_THINK_LLM=google/gemma-4-26b-a4b-qat

#TRADINGAGENTS_LLM_BACKEND_URL=not_needed_for_local_llm

# Crypto data — Suggested but optional; Binance public REST default is used if not set.
COINGECKO_API_KEY=your_key_here
CRYPTOCOMPARE_API_KEY=your_key_here
# for social analysis, sentiment analysis, news analysis, etc.
LUNARCRUSH_API_KEY=your_key_here

## LLM SETTINGS:
# Temperature: 0.7 for qwen, 1.0 for gemma4, or set server-side.
#TRADINGAGENTS_TEMPERATURE=0.0  

#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Paper trading simulation — uncomment or use: python -m cli.paper
# You do not need to set these if you want to set interactively in CLI.

#TRADINGAGENTS_PAPER_TRADE_ENABLED=true
#TRADINGAGENTS_PAPER_STOP_LOSS_PCT=0.02             # e.g. 0.02 = 2% adverse move triggers exit
#TRADINGAGENTS_PAPER_TAKE_PROFIT_PCT=0.04         # optional; empty/unset → 2× stop-loss at runtime
#TRADINGAGENTS_PAPER_TRADE_ENABLED=false
#TRADINGAGENTS_PAPER_INITIAL_EQUITY=10000
#TRADINGAGENTS_PAPER_TICK_INTERVAL_SECONDS=10
#TRADINGAGENTS_PAPER_STATE_ENABLED=true
# Stop-loss / take-profit
#TRADINGAGENTS_PAPER_STOP_LOSS_PCT=0.02
#TRADINGAGENTS_PAPER_TAKE_PROFIT_PCT=0.04

# Adaptive re-backtest / autonomous rotation
#TRADINGAGENTS_PAPER_ADAPTIVE_ENABLED=true
#TRADINGAGENTS_PAPER_LOSS_REVIEW_MINUTES=60
#TRADINGAGENTS_PAPER_LOSS_THRESHOLD_PCT=5.0
#TRADINGAGENTS_DRAWDOWN_TIME_WINDOW=60
# Max minutes of equity history for drawdown checks (caps unbounded growth when idle).
# Defaults to TRADINGAGENTS_DRAWDOWN_TIME_WINDOW when unset.
#TRADINGAGENTS_DRAWDOWN_MAX_LOOKBACK_MINUTES=60
#TRADINGAGENTS_MAX_ALLOWED_DRAWDOWN_PCT=5.0

# Live price feed — ccxt Binance ticker when CryptoCompare/CoinGecko unavailable
# Interactive CLI defaults to enabled (Enter = Yes); set explicitly to override.
#LIVE_MODE=1
#TRADINGAGENTS_LIVE_MODE=true

################################################################################
################################################################################
### LOCAL LLM SETTINGS END HERE.
###
###  To run with local LLM, use: python -m cli.main --help
################################################################################
################################################################################



# =============================================================================
# External LLM Provider API Keys (detail)
# =============================================================================
# Required for the cloud provider you use; leave others unset.
# Mapping: tradingagents/llm_clients/api_key_env.py. 
# 
# COMMENT OUT THE LOCAL LLM SETTINGS ABOVE WITH # IF USING EXTERNAL LLM PROVIDER.

OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
ATLASCLOUD_API_KEY=your_key_here
XAI_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# Dual-region providers — international and China endpoints use separate accounts
DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_CN_API_KEY=your_key_here
ZHIPU_API_KEY=your_key_here
ZHIPU_CN_API_KEY=your_key_here
MINIMAX_API_KEY=your_key_here
MINIMAX_CN_API_KEY=your_key_here

# Azure OpenAI — see also .env.enterprise.example
AZURE_OPENAI_API_KEY=your_key_here
#AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
#AZURE_OPENAI_DEPLOYMENT_NAME=
#OPENAI_API_VERSION=2024-10-21

# =============================================================================
# TradingAgents Runtime (TRADINGAGENTS_*)
# =============================================================================
# Full list: tradingagents/default_config.py → _ENV_OVERRIDES. Duplicates
# QUICK START provider/model vars — uncomment when switching off local LLM.

# Provider & models - if using local you already set these above.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_TEMPERATURE=0.0

# Output & debate
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1

# LangGraph checkpoint/resume after each node (also: --checkpoint flag)
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Benchmark pair for alpha in the reflection layer (overrides auto-detection)
#TRADINGAGENTS_BENCHMARK_TICKER=ETH/USDT

# Provider-specific reasoning / thinking — no TRADINGAGENTS_* env override yet.
# Set via interactive CLI (Step 8) or programmatically in DEFAULT_CONFIG:
#   google_thinking_level, openai_reasoning_effort, anthropic_effort

# Verbose traceback on backtest data-fetch failures (README: TRADINGAGENTS_DEBUG=1)
#TRADINGAGENTS_DEBUG=false


# If you set these above, you don't need to set them here. 

# =============================================================================
# Each vendor accepts a plain key or TRADINGAGENTS_<VENDOR>_API_KEY alias.

# CoinGecko — Demo keys → api.coingecko.com; Pro keys → pro-api.coingecko.com
COINGECKO_API_KEY=your_key_here
#COINGECKO_API_TIER=auto
#TRADINGAGENTS_COINGECKO_API_KEY=your_key_here

# LunarCrush — galaxy score, social volume (required for LunarCrush sentiment tools)
LUNARCRUSH_API_KEY=your_key_here
#TRADINGAGENTS_LUNARCRUSH_API_KEY=your_key_here

# CryptoCompare — OHLCV fallback and crypto news (public limits without key)
CRYPTOCOMPARE_API_KEY=your_key_here
#TRADINGAGENTS_CRYPTOCOMPARE_API_KEY=your_key_here

# Glassnode — on-chain metrics stub (extend onchain_metrics.py for live use)
#GLASSNODE_API_KEY=your_key_here
#TRADINGAGENTS_GLASSNODE_API_KEY=your_key_here

# Binance USD-M perps (funding, open interest) and primary OHLCV — public REST, no key.


# =============================================================================
# Backtest / Live / Paper Trading 
# =============================================================================
# If you set these above, you don't need to set them here. 
#
# If you don't set them, you will be prompted interactively in CLI.

# Backtest OHLCV — ccxt exchange order when CryptoCompare/Binance fail (451, rate limit).
# Default: kraken,coinbase,binance. US users: kraken,coinbase skips geo-blocked Binance.
#BACKTEST_CCXT_EXCHANGES=kraken,coinbase

# Backtest OHLCV disk cache TTL (seconds). When unset: 10m for 5m bars, 15m for 15m,
# 1h for hourly, 24h for fully closed past-date windows. Applies under historic_crypto/.
#BACKTEST_CACHE_TTL_SECONDS=600

# Live price feed — ccxt Binance ticker when CryptoCompare/CoinGecko unavailable
# Interactive CLI defaults to enabled (Enter = Yes); set explicitly to override.
#LIVE_MODE=1
#TRADINGAGENTS_LIVE_MODE=false

# Paper trading simulation (no real orders)
#TRADINGAGENTS_PAPER_TRADE_ENABLED=false
#TRADINGAGENTS_PAPER_INITIAL_EQUITY=10000
#TRADINGAGENTS_PAPER_TICK_INTERVAL_SECONDS=10
#TRADINGAGENTS_PAPER_STATE_ENABLED=true
# Stop-loss / take-profit (fractional; 0.02 = 2%). Take-profit defaults to 2× stop-loss if unset.
#TRADINGAGENTS_PAPER_STOP_LOSS_PCT=0.02
#TRADINGAGENTS_PAPER_TAKE_PROFIT_PCT=0.04

# Adaptive re-backtest / autonomous rotation
#TRADINGAGENTS_PAPER_ADAPTIVE_ENABLED=true
#TRADINGAGENTS_PAPER_LOSS_REVIEW_MINUTES=60
#TRADINGAGENTS_PAPER_LOSS_THRESHOLD_PCT=5.0
#TRADINGAGENTS_DRAWDOWN_TIME_WINDOW=60
# Max minutes of equity history for drawdown checks (caps unbounded growth when idle).
# Defaults to TRADINGAGENTS_DRAWDOWN_TIME_WINDOW when unset.
#TRADINGAGENTS_DRAWDOWN_MAX_LOOKBACK_MINUTES=60
#TRADINGAGENTS_MAX_ALLOWED_DRAWDOWN_PCT=5.0

# Slippage is not env-configurable — SimulatedMatcher defaults to 5 bps; the
# optimization engine derives slippage from transaction_cost_pct in code.


# =============================================================================
# Paths
# =============================================================================

#TRADINGAGENTS_RESULTS_DIR=~/.tradingagents/logs
#TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache
#TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md


